# Project
PROJECT_NAME=financial-fraud-mlops
ENVIRONMENT=development
RANDOM_STATE=42

# AWS S3
AWS_REGION=ap-south-1
S3_BUCKET_NAME=replace-with-your-unique-bucket-name
S3_RAW_PREFIX=data/raw/
S3_VALIDATED_PREFIX=data/validated/
S3_PROCESSED_PREFIX=data/processed/
S3_ARTIFACTS_PREFIX=artifacts/

# PostgreSQL
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/fraud_detection

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=financial-transactions

# Machine Learning
TARGET_COLUMN=isFraud
RANDOM_STATE=42
MODEL_SELECTION_METRIC=average_precision

# MLflow
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=financial-fraud-detection
